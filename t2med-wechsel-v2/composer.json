{
  "name": "leadwerk/t2med-wordpress-package",
  "description": "Development checks for the Leadwerk T2med WordPress packages.",
  "license": "proprietary",
  "type": "project",
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.10",
    "wp-coding-standards/wpcs": "^3.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "validate": "php tests/validate-package.php",
    "phpunit": "phpunit",
    "phpcs": "phpcs --standard=phpcs.xml.dist",
    "test": [
      "@validate",
      "@phpunit",
      "@phpcs"
    ]
  }
}
